{
  "functions": {
    "src/app/api/roadmaps/**": {
      "maxDuration": 60
    },
    "src/app/api/chat/**": {
      "maxDuration": 60
    },
    "src/app/api/lessons/**": {
      "maxDuration": 60
    },
    "src/app/api/inngest/**": {
      "maxDuration": 300
    }
  },
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "hipath.ai" }],
      "destination": "https://www.hipathai.me/$1",
      "permanent": true
    }
  ]
}