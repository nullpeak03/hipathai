# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA NIM (server-only, never prefix with NEXT_PUBLIC)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_ULTRA_ID=nvidia/nemotron-3-ultra-550b-a55b
NIM_LIGHTNING_ID=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_GLIMMER_ID=meta/muse-glimmer-30b

# Google Gemini (last-resort fallback for all AI tasks — roadmap, lesson, quiz, tutor, review)
# Get key at https://aistudio.google.com/api-keys
GOOGLE_API_KEY=
# or GEMINI_API_KEY= (alias, either works)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub (optional, raises API quota 60 -> 5000/hr for project review fetch)
GITHUB_TOKEN=
